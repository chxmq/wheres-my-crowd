{
  "name": "wheres-my-crowd",
  "version": "0.1.0",
  "description": "A tour-planning agent for independent musicians and comedians, grounded in Qloo's taste graph.",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "MOCK=1 node server.js",
    "dev:live": "node --env-file=.env server.js",
    "test": "node --test test/*.test.js",
    "smoke:live": "node --env-file-if-exists=.env scripts/smoke-live.mjs",
    "build:cities": "node scripts/build-cities.mjs"
  },
  "license": "MIT",
  "type": "module",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "@qloo/qloo-harness": "^0.1.26",
    "express": "^5.3.0"
  },
  "engines": {
    "node": ">=22.19.0"
  }
}