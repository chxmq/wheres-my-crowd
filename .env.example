# Copy to .env for local runs. Never commit real values.
QLOO_API_KEY=replace-with-your-event-credential
# Optional: lets Gemini choose the Qloo tools. Without it, the fixed booking workflow runs.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest
PORT=8787
# Hackathon keys only work against the hackathon API (these are the defaults if unset)
QLOO_BASE_URL=https://hackathon.api.qloo.com
QLOO_TRUSTED_BASE_URL=https://hackathon.api.qloo.com
